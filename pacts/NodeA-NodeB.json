{
  "consumer": {
    "name": "NodeA"
  },
  "interactions": [
    {
      "description": "a request for file metadata",
      "providerStates": [
        {
          "name": "a file exists"
        }
      ],
      "request": {
        "method": "GET",
        "path": "/files/test.txt/metadata"
      },
      "response": {
        "body": {
          "block_size": 1024,
          "blocks": [
            {
              "index": 0,
              "strong_hash": "sha256hash",
              "weak_hash": 12345
            }
          ],
          "filePath": "test.txt",
          "full_hash": "abc123",
          "modified_at": "2023-10-27T10:00:00.000Z",
          "size": 10
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "matchingRules": {
          "body": {
            "$.block_size": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "integer"
                }
              ]
            },
            "$.blocks": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type",
                  "min": 1
                }
              ]
            },
            "$.blocks[*].index": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "integer"
                }
              ]
            },
            "$.blocks[*].strong_hash": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.blocks[*].weak_hash": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "integer"
                }
              ]
            },
            "$.filePath": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.full_hash": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.modified_at": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.size": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "integer"
                }
              ]
            }
          }
        },
        "status": 200
      }
    },
    {
      "description": "a request for non-existent file metadata",
      "providerStates": [
        {
          "name": "no file exists"
        }
      ],
      "request": {
        "method": "GET",
        "path": "/files/nonexistent.txt/metadata"
      },
      "response": {
        "status": 404
      }
    },
    {
      "description": "a request to patch a file",
      "providerStates": [
        {
          "name": "a file can be patched"
        }
      ],
      "request": {
        "body": {
          "base_full_hash": "abc123",
          "final_full_hash": "def456",
          "patches": [
            {
              "byte_index": 0,
              "data": "aGVsbG8=",
              "index": 0,
              "type": "new_block"
            }
          ]
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "matchingRules": {
          "body": {
            "$.base_full_hash": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.final_full_hash": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.patches": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type",
                  "min": 1
                }
              ]
            },
            "$.patches[*].byte_index": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "integer"
                }
              ]
            },
            "$.patches[*].data": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.patches[*].index": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "integer"
                }
              ]
            }
          }
        },
        "method": "PATCH",
        "path": "/files/test.txt"
      },
      "response": {
        "body": {
          "status": "success"
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "matchingRules": {
          "body": {
            "$.status": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          }
        },
        "status": 200
      }
    }
  ],
  "metadata": {
    "pact-js": {
      "version": "16.5.0"
    },
    "pactRust": {
      "ffi": "0.5.4",
      "models": "1.3.11"
    },
    "pactSpecification": {
      "version": "3.0.0"
    }
  },
  "provider": {
    "name": "NodeB"
  }
}